    cpp_name: "add_Int",
    code: "inline Obj<std::int64_t> add_Int(Obj<std::int64_t> a, Obj<std::int64_t> b, Loc loc) { return make_obj<std::int64_t>(checked_int((__int128)*a + *b, loc)); }",
}

