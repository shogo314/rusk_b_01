}

extern fn __read__() -> Int {
    cpp_name: "read_Int",
    code: "inline Obj<std::int64_t> read_Int(Loc loc) {\n    auto token = read_token(loc);\n    const char* first = token.data(); const char* last = first + token.size();\n    if (first != last && *first == '+') { ++first; if (first == last || *first < '0' || *first > '9') fail(loc, \"invalid integer input\"); }\n    std::int64_t value = 0;\n    auto result = std::from_chars(first, last, value);\n    if (result.ec == std::errc::result_out_of_range) fail(loc, \"integer input out of range\");\n    if (result.ec != std::errc{} || result.ptr != last) fail(loc, \"invalid integer input\");\n    return make_obj<std::int64_t>(value);\n}",
}

extern fn __read__() -> Str {
    cpp_name: "read_Str",
    code: "inline Obj<std::string> read_Str(Loc loc) {\n    auto value = read_token(loc); require_ascii(value, loc); return make_obj<std::string>(value);\n}",
}

extern fn __read__() -> Char {
    cpp_name: "read_Char",
    code: "inline Obj<char> read_Char(Loc loc) {\n    while (ascii_space(std::cin.peek())) std::cin.get();\n    int c = std::cin.get();\n    if (c == std::char_traits<char>::eof()) fail(loc, \"unexpected end of input\");\n    if (c > 127) fail(loc, \"non-ASCII input\");\n    return make_obj<char>(static_cast<char>(c));\n}",
}

extern fn read_line() -> Str {
    cpp_name: "read_line_Str",
    code: "inline Obj<std::string> read_line_Str(Loc loc) {\n    std::string value;\n    if (!std::getline(std::cin, value)) fail(loc, \"unexpected end of input\");\n    if (!value.empty() && value.back() == '\\r') value.pop_back();\n    require_ascii(value, loc); return make_obj<std::string>(value);\n}",
}

